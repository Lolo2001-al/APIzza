    }
    ITEMS_PEDIDO {
        int Id PK
        int PedidoId FK
        int PizzaId FK
        int Cantidad
        decimal PrecioUnitario
    }
    PIZZAS {
        int Id PK
        varchar Nombre
        varchar Descripcion
        decimal Precio
        varchar Categoria
    }
