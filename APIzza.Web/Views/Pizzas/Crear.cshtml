@model PizzaCrearViewModel
@{
    ViewData["Title"] = "Agregar pizza";
}

<h1 class="titulo">Agregar una pizza al menú</h1>

<form asp-action="Crear" method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <section class="caja">
        <h2>Datos de la pizza</h2>

        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" autocomplete="off" />
        <span asp-validation-for="Nombre" class="error"></span>

        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="error"></span>

        <label asp-for="Precio"></label>
        <input asp-for="Precio" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="Precio" class="error"></span>

        <label asp-for="Categoria"></label>
        <select asp-for="Categoria">
            <option value="clasica">Clásica</option>
            <option value="especial">Especial</option>
            <option value="vegetariana">Vegetariana</option>
        </select>
        <span asp-validation-for="Categoria" class="error"></span>

        <button type="submit" class="btn">Guardar pizza</button>
        <a class="btn btn-borde oscuro" asp-action="Index">Cancelar</a>
    </section>
</form>
